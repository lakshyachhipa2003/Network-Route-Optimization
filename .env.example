DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=sqlite
# Set DB_ENGINE=postgresql and fill these values for PostgreSQL.
DB_NAME=network_routes
DB_USER=network_routes
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432
# Enable with HTTPS in production.
DJANGO_SECURE_SSL_REDIRECT=false
